[Unit]
Description=webterm — multi-project web terminal (API + reverse proxy)
Documentation=https://github.com/randyh0329/cloud_cli
After=network.target

[Service]
Type=simple
# Rewritten to the absolute path of this checkout by `npm run install-units`
# (systemd.renderMainUnit). The placeholder below is deliberately obvious: a
# wrong WorkingDirectory fails at boot as a bare status=200/CHDIR that names
# nothing. If you install this file by hand, edit the line yourself.
WorkingDirectory=/path/to/cloud_cli
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:%h/.local/bin
# Uncomment if `./scripts/smoke.sh` reports that this ttyd wants an interface
# name rather than an address for -i. Both values are loopback-only.
#Environment=WEBTERM_TTYD_IFACE=lo
ExecStart=/usr/bin/env node server/index.js

Restart=always
RestartSec=2s

# webterm shells out to `systemctl --user` and `tmux`; it must keep its own
# session bus and PATH, so no filesystem/privilege sandboxing here either.

[Install]
# default.target is the user manager's boot target. For that manager to exist
# at boot with nobody logged in, lingering must be on:
#   sudo loginctl enable-linger $USER
# install.sh does this; without it, "enabled" only takes effect at next login.
WantedBy=default.target
